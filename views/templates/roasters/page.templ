package roasters

import (
	"github.com/lescactus/espressoapi-go/internal/services/roaster"
	"github.com/lescactus/espressoapi-go/views/templates/shared"
)

templ sortHeader(label, col, sortCol, order string) {
	<th>
		<a href="#" hx-get={ "/roasters?sort=" + col + "&order=" + nextSortOrder(sortCol, order, col) } hx-target="#roasters-table" hx-swap="outerHTML">
			{ label }
			if sortCol == col && order == "asc" {
				<span> &#9650;</span>
			}
			if sortCol == col && order == "desc" {
				<span> &#9660;</span>
			}
		</a>
	</th>
}

// Table renders the roasters table fragment. addOpen prepends a blank add row.
templ Table(roasters []roaster.Roaster, sortCol, order string, addOpen bool) {
	<table id="roasters-table">
		<thead>
			<tr>
				@sortHeader("ID", "id", sortCol, order)
				@sortHeader("Name", "name", sortCol, order)
				@sortHeader("Created", "created_at", sortCol, order)
				@sortHeader("Updated", "updated_at", sortCol, order)
				<th>Actions</th>
			</tr>
		</thead>
		<tbody id="roasters-tbody">
			if addOpen {
				@AddRow(FormState{})
			}
			for _, r := range roasters {
				@Row(r)
			}
		</tbody>
	</table>
}

// Page renders the full roasters list page.
templ Page(roasters []roaster.Roaster, sortCol, order string, addOpen bool) {
	@shared.Layout("Roasters", "roasters") {
		<hgroup>
			<h1>Roasters</h1>
			<p>The professionals who roast your coffee beans.</p>
		</hgroup>
		<a role="button" hx-get="/roasters/add" hx-target="#roasters-tbody" hx-swap="afterbegin">Add roaster</a>
		<div class="table-scroll">
			@Table(roasters, sortCol, order, addOpen)
		</div>
	}
}

// EditRowPage renders the full roasters list page with one row already in
// edit mode (full-page fallback for a direct GET to the update URL).
templ EditRowPage(roasters []roaster.Roaster, state FormState, createdAt, updatedAt string) {
	@shared.Layout("Roasters", "roasters") {
		<hgroup>
			<h1>Roasters</h1>
			<p>The professionals who roast your coffee beans.</p>
		</hgroup>
		<a role="button" hx-get="/roasters/add" hx-target="#roasters-tbody" hx-swap="afterbegin">Add roaster</a>
		<div class="table-scroll">
			<table id="roasters-table">
				<thead>
					<tr>
						<th>ID</th>
						<th>Name</th>
						<th>Created</th>
						<th>Updated</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody id="roasters-tbody">
					for _, r := range roasters {
						if r.Id == state.ID {
							@EditRow(state, createdAt, updatedAt)
						} else {
							@Row(r)
						}
					}
				</tbody>
			</table>
		</div>
	}
}

// RowPage renders a single roaster row inside a minimal one-row table,
// wrapped in the shared layout. Used as the full-page fallback for a direct
// GET to /roasters/get/:id.
templ RowPage(r roaster.Roaster) {
	@shared.Layout(r.Name, "roasters") {
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>ID</th>
						<th>Name</th>
						<th>Created</th>
						<th>Updated</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					@Row(r)
				</tbody>
			</table>
		</div>
	}
}
