package sheets

import (
	"github.com/lescactus/espressoapi-go/internal/services/sheet"
	"github.com/lescactus/espressoapi-go/views/templates/shared"
)

templ sortHeader(label, col, sortCol, order string) {
	<th>
		<a href="#" hx-get={ "/sheets?sort=" + col + "&order=" + nextSortOrder(sortCol, order, col) } hx-target="#sheets-table" hx-swap="outerHTML">
			{ label }
			if sortCol == col && order == "asc" {
				<span> &#9650;</span>
			}
			if sortCol == col && order == "desc" {
				<span> &#9660;</span>
			}
		</a>
	</th>
}

// Table renders the sheets table fragment (used both on the full list page
// and as the htmx sort-refresh target). addOpen prepends a blank add row.
templ Table(sheets []sheet.Sheet, sortCol, order string, addOpen bool) {
	<table id="sheets-table">
		<thead>
			<tr>
				@sortHeader("ID", "id", sortCol, order)
				@sortHeader("Name", "name", sortCol, order)
				@sortHeader("Created", "created_at", sortCol, order)
				@sortHeader("Updated", "updated_at", sortCol, order)
				<th>Actions</th>
			</tr>
		</thead>
		<tbody id="sheets-tbody">
			if addOpen {
				@AddRow(FormState{})
			}
			for _, s := range sheets {
				@Row(s)
			}
		</tbody>
	</table>
}

// Page renders the full sheets list page.
templ Page(sheets []sheet.Sheet, sortCol, order string, addOpen bool) {
	@shared.Layout("Sheets", "sheets") {
		<hgroup>
			<h1>Sheets</h1>
			<p>Kinds of drinks you track shots against.</p>
		</hgroup>
		<a role="button" hx-get="/sheets/add" hx-target="#sheets-tbody" hx-swap="afterbegin">Add sheet</a>
		<div class="table-scroll">
			@Table(sheets, sortCol, order, addOpen)
		</div>
	}
}

// EditRowPage renders the full sheets list page with one row already in
// edit mode (full-page fallback for a direct GET to the update URL).
templ EditRowPage(sheets []sheet.Sheet, state FormState, createdAt, updatedAt string) {
	@shared.Layout("Sheets", "sheets") {
		<hgroup>
			<h1>Sheets</h1>
			<p>Kinds of drinks you track shots against.</p>
		</hgroup>
		<a role="button" hx-get="/sheets/add" hx-target="#sheets-tbody" hx-swap="afterbegin">Add sheet</a>
		<div class="table-scroll">
			<table id="sheets-table">
				<thead>
					<tr>
						<th>ID</th>
						<th>Name</th>
						<th>Created</th>
						<th>Updated</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody id="sheets-tbody">
					for _, s := range sheets {
						if s.Id == state.ID {
							@EditRow(state, createdAt, updatedAt)
						} else {
							@Row(s)
						}
					}
				</tbody>
			</table>
		</div>
	}
}
