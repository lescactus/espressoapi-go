package sheets

import (
	"strconv"

	"github.com/lescactus/espressoapi-go/internal/services/sheet"
	"github.com/lescactus/espressoapi-go/internal/services/shot"
	"github.com/lescactus/espressoapi-go/views/templates/shared"
)

// DetailHeader renders the sheet detail page's header in view mode.
templ DetailHeader(s sheet.Sheet) {
	<hgroup id="sheet-detail-header">
		<h1>{ s.Name }</h1>
		<p>
			Created { shared.FormatTimestamp(s.CreatedAt) } &middot; Updated { shared.FormatTimestamp(s.UpdatedAt) }
		</p>
		<a
			href="#"
			hx-get={ updatePath(s.Id) + "?view_context=sheet-detail" }
			hx-target="#sheet-detail-header"
			hx-swap="outerHTML"
		>Rename</a>
		<a
			href="#"
			hx-delete={ deletePath(s.Id) + "?view_context=sheet-detail" }
			hx-confirm={ "Are you sure you want to delete " + s.Name + "?" }
		>Delete</a>
	</hgroup>
}

// DetailHeaderEdit renders the sheet detail page's header in edit mode.
templ DetailHeaderEdit(state FormState, createdAt, updatedAt string) {
	<hgroup id="sheet-detail-header">
		<input type="text" name="name" required value={ state.Name } { nameFieldAttrs(state.Error)... }/>
		if state.Error != "" {
			<small>{ state.Error }</small>
		}
		<p>Created { createdAt } &middot; Updated { updatedAt }</p>
		<button
			type="button"
			hx-put={ updatePath(state.ID) + "?view_context=sheet-detail" }
			hx-include="closest hgroup"
			hx-target="#sheet-detail-header"
			hx-swap="outerHTML"
		>Save</button>
		<a
			href="#"
			hx-get={ getPath(state.ID) + "?view_context=sheet-detail" }
			hx-target="#sheet-detail-header"
			hx-swap="outerHTML"
		>Cancel</a>
	</hgroup>
}

// ShotsSummary renders a read-only summary table of a sheet's shots. Full
// add/edit/delete wiring is added alongside the /shots feature.
templ ShotsSummary(shots []shot.Shot) {
	<div class="table-scroll">
		if len(shots) == 0 {
			<p><em>No shots logged for this sheet yet.</em></p>
		} else {
			<table>
				<thead>
					<tr>
						<th>ID</th>
						<th>Beans</th>
						<th>Grind</th>
						<th>In (g)</th>
						<th>Out (g)</th>
						<th>Rating</th>
						<th>Logged</th>
					</tr>
				</thead>
				<tbody>
					for _, sh := range shots {
						<tr>
							<td>{ strconv.Itoa(sh.Id) }</td>
							if sh.Beans != nil {
								<td>{ sh.Beans.Name }</td>
							} else {
								<td></td>
							}
							<td>{ strconv.Itoa(sh.GrindSetting) }</td>
							<td>{ strconv.FormatFloat(sh.QuantityIn, 'f', 1, 64) }</td>
							<td>{ strconv.FormatFloat(sh.QuantityOut, 'f', 1, 64) }</td>
							<td>{ strconv.FormatFloat(sh.Rating, 'f', 1, 64) }</td>
							<td>{ shared.FormatTimestamp(sh.CreatedAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

// Detail renders the full sheet detail page.
templ Detail(s sheet.Sheet, shots []shot.Shot) {
	@shared.Layout(s.Name, "sheets") {
		@DetailHeader(s)
		@ShotsSummary(shots)
	}
}

// DetailEditing renders the full sheet detail page with the header already
// in edit mode (full-page fallback for a direct GET to the update URL).
templ DetailEditing(state FormState, createdAt, updatedAt string, shots []shot.Shot) {
	@shared.Layout(state.Name, "sheets") {
		@DetailHeaderEdit(state, createdAt, updatedAt)
		@ShotsSummary(shots)
	}
}
